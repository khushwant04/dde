# OpenAI Responses-compatible endpoint.
# Azure example: https://YOUR-RESOURCE.openai.azure.com/openai/v1/
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Model ID or Azure deployment name.
DDE_MODEL=

# api_key or azure_identity
DDE_AUTH_MODE=api_key

DDE_MAX_FILE_BYTES=15728640
DDE_MAX_PAGES=10
DDE_MAX_IMAGE_PIXELS=25000000
DDE_RENDER_DPI=144
DDE_REQUEST_TIMEOUT_SECONDS=120
DDE_LOG_LEVEL=INFO
